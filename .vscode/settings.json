{
  // ===== Theme =====
  "workbench.colorTheme": "Cobalt2",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "window.commandCenter": false,
  "window.titleBarStyle": "custom",

  // ===== Font =====
  "editor.fontFamily": "JetBrains Mono, Geist Mono, Fira Code, Cascadia Code, Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontWeight": "500",

  // ===== Editor look =====
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,

  // ===== Clean UI =====
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,
  "editor.links": false,
  "editor.dragAndDrop": false,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "breadcrumbs.enabled": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.layoutControl.enabled": false,

  // ===== Guides =====
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": false,
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,

  // ===== Suggestions =====
  "editor.quickSuggestionsDelay": 80,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "on",
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.showStatusBar": false,
  "editor.parameterHints.enabled": true,

  // ===== Formatting =====
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // ===== Prettier =====
  "prettier.singleQuote": false,
  "prettier.semi": true,
  "prettier.tabWidth": 2,
  "prettier.trailingComma": "es5",
  "prettier.bracketSpacing": true,
  "prettier.arrowParens": "always",
  "prettier.endOfLine": "lf",

  // ===== Files =====
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 800,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  // ===== Explorer =====
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "tsconfig.json": "tsconfig.*.json",
    ".env": ".env.*",
    "vite.config.*": "vitest.config.*, postcss.config.*, tailwind.config.*"
  },

  // ===== Search =====
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/coverage": true,
    "**/.next": true,
    "**/.vite": true
  },

  // ===== Files exclude =====
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },

  // ===== Terminal =====
  "terminal.integrated.fontFamily": "JetBrains Mono, Cascadia Code, Consolas, monospace",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.defaultProfile.windows": "PowerShell",

  // ===== JavaScript / TypeScript =====
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "javascript.preferences.importModuleSpecifier": "non-relative",

  // ===== Emmet =====
  "emmet.triggerExpansionOnTab": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },

  // ===== Git =====
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,

  // ===== Performance =====
  "editor.largeFileOptimizations": true,
  "extensions.ignoreRecommendations": true,

  // ===== Custom Cobalt2 UI Colors =====
  "workbench.colorCustomizations": {
    "editor.background": "#193549",
    "editor.foreground": "#FFFFFF",
    "editorLineNumber.foreground": "#5A7A8C",
    "editorLineNumber.activeForeground": "#FFC600",

    "editorCursor.foreground": "#FFC600",
    "editor.selectionBackground": "#2F5D7C",
    "editor.inactiveSelectionBackground": "#24475F",
    "editor.lineHighlightBackground": "#1F4662",

    "editorIndentGuide.background1": "#2D536B",
    "editorIndentGuide.activeBackground1": "#FFC600",

    "sideBar.background": "#102A3A",
    "sideBar.foreground": "#D6E9F5",
    "sideBarSectionHeader.background": "#0D2230",

    "activityBar.background": "#0B1F2A",
    "activityBar.foreground": "#FFC600",
    "activityBar.inactiveForeground": "#6D8FA3",

    "statusBar.background": "#0B1F2A",
    "statusBar.foreground": "#FFC600",
    "statusBar.noFolderBackground": "#0B1F2A",
    "statusBar.debuggingBackground": "#FF628C",

    "titleBar.activeBackground": "#0B1F2A",
    "titleBar.activeForeground": "#FFFFFF",
    "titleBar.inactiveBackground": "#0B1F2A",
    "titleBar.inactiveForeground": "#6D8FA3",

    "tab.activeBackground": "#193549",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "#102A3A",
    "tab.inactiveForeground": "#8FB3C8",
    "tab.border": "#0B1F2A",
    "tab.activeBorderTop": "#FFC600",

    "terminal.background": "#102A3A",
    "terminal.foreground": "#FFFFFF",
    "terminalCursor.foreground": "#FFC600",

    "input.background": "#102A3A",
    "input.foreground": "#FFFFFF",
    "input.border": "#2D536B",

    "dropdown.background": "#102A3A",
    "dropdown.foreground": "#FFFFFF",
    "dropdown.border": "#2D536B",

    "list.activeSelectionBackground": "#1F4662",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.hoverBackground": "#193549",
    "list.hoverForeground": "#FFFFFF",

    "scrollbarSlider.background": "#FFFFFF22",
    "scrollbarSlider.hoverBackground": "#FFFFFF33",
    "scrollbarSlider.activeBackground": "#FFFFFF44"
  }
}
